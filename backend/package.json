{
  "name": "elite-estate-crm-backend",
  "version": "1.0.0",
  "description": "Enterprise Real Estate CRM - Backend API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --pretty false",
    "prestart": "tsc --pretty false",
    "start": "node dist/server.js",
    "postinstall": "tsc --pretty false",
    "render:build": "npm ci --include=dev --include=optional && npm run build",
    "render:start": "npm run render:build && npm start",
    "seed": "ts-node src/scripts/seedAdmin.ts",
    "seed:sample": "ts-node src/scripts/seedSample.ts",
    "import:enquiries": "ts-node src/scripts/importEnquiries.ts",
    "migrate:sql-backup": "ts-node src/scripts/migrateSqlBackup.ts",
    "backfill:latest-nfd": "ts-node src/scripts/backfillLatestNfd.ts",
    "close:overdue": "ts-node src/scripts/closeOverdueLeads.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "file:vendor/mongoose-postgres",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.3",
    "sharp": "^0.35.2",
    "typescript": "^5.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.15.5",
    "mssql": "^12.7.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
