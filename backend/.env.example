NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_32_chars
JWT_EXPIRES_IN=7d
ADMIN_NAME=Elite Estate Admin
ADMIN_EMAIL=admin@eliteestate.com
ADMIN_PASSWORD=replace_with_a_strong_password
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
FRONTEND_URL=http://localhost:3000
WEBSITE_URL=http://localhost:3001
# Production (Render): set FRONTEND_URL to your Vercel URL, e.g.
# FRONTEND_URL=https://elite-estate.vercel.app
