NODE_ENV=development
PORT=5000
DATABASE_URL=mongodb+srv://user:password@host/elite_estate_demo
MONGODB_URI=mongodb+srv://user:password@host/elite_estate_demo
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_32_chars
JWT_EXPIRES_IN=7d
ADMIN_NAME=Elite Estate Demo Admin
ADMIN_EMAIL=demo@eliteestate.com
ADMIN_PASSWORD=Demo@12345
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
FRONTEND_URL=http://localhost:3000
WEBSITE_URL=http://localhost:3001
DEMO_MODE=false

# Production (Render): set FRONTEND_URL to your Vercel URL, e.g.
# FRONTEND_URL=https://elite-estate.vercel.app
